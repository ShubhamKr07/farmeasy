{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:metrics": "node --import tsx/esm --test src/tests/metrics/*.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.1",
    "@supabase/supabase-js": "^2.112.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/metrics": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "http-proxy-middleware": "^4.2.0",
    "intuit-oauth": "^4.2.5",
    "jose": "^6.2.8",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.18.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "mailosaur": "^11.1.1",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "4.2.0",
    "tsx": "catalog:"
  }
}
